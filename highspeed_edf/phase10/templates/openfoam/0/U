FoamFile
{
    version 2.0;
    format ascii;
    class volVectorField;
    object U;
}
dimensions [0 1 -1 0 0 0 0];
internalField uniform (0 @U_IN@ 0);
boundaryField
{
    inlet { type pressureInletOutletVelocity; value uniform (0 @U_IN@ 0); }
    outlet { type pressureInletOutletVelocity; value uniform (0 0 0); }
    walls { type noSlip; }
}
