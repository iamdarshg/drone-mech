FoamFile { version 2.0; format ascii; class dictionary; location "system"; object fvSolution; }
solvers
{
 rhoU { solver PBiCGStab; preconditioner DILU; tolerance 1e-7; relTol 0.1; }
 rhoUFinal { $rhoU; relTol 0; }
 rhoE { solver PBiCGStab; preconditioner DILU; tolerance 1e-7; relTol 0.1; }
 rhoEFinal { $rhoE; relTol 0; }
 p { solver PBiCGStab; preconditioner DILU; tolerance 1e-7; relTol 0.05; smoother GaussSeidel; }
 pFinal { $p; relTol 0; }
 pcorr { solver PCG; preconditioner DIC; tolerance 1e-6; relTol 0; }
 pcorrFinal { $pcorr; }
 rho { solver PCG; preconditioner DIC; tolerance 1e-7; relTol 0; }
 rhoFinal { $rho; }
 "(U|h|k|omega)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0.1; }
 "(U|h|k|omega)Final" { $U; relTol 0; }
}
PIMPLE { transonic yes; nNonOrthogonalCorrectors 3; nOuterCorrectors 2; nCorrectors 2; momentumPredictor yes; }
relaxationFactors { fields { p 0.3; } equations { U 0.5; h 0.5; k 0.5; omega 0.5; } }
