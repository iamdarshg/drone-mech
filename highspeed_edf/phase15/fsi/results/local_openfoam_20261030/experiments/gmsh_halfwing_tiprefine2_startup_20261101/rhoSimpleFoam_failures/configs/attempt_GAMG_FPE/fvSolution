FoamFile { version 2.0; format ascii; class dictionary; location "system"; object fvSolution; }
solvers
{ p { solver GAMG; tolerance 1e-7; relTol 0.02; smoother GaussSeidel; } pFinal { $p; relTol 0; } rho { solver diagonal; } "(U|h|k|omega)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0.05; maxIter 1000; } "(U|h|k|omega)Final" { $U; tolerance 1e-8; relTol 0; maxIter 1000; } }
SIMPLE { transonic yes; consistent yes; nNonOrthogonalCorrectors 0; }
relaxationFactors { fields { p 0.25; rho 0.25; } equations { U 0.3; h 0.3; k 0.3; omega 0.3; } }
