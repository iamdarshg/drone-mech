FoamFile { version 2.0; format ascii; class dictionary; location "system"; object fvSolution; }
solvers { p { solver smoothSolver; smoother GaussSeidel; tolerance 1e-5; relTol 0.1; maxIter 200; } pFinal { $p; tolerance 1e-6; relTol 0; maxIter 400; } rho { solver diagonal; } "(U|h|k|omega)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-6; relTol 0.1; maxIter 200; } "(U|h|k|omega)Final" { $U; tolerance 1e-7; relTol 0; maxIter 400; } }
SIMPLE { transonic yes; nNonOrthogonalCorrectors 0; }
relaxationFactors { fields { p 0.1; rho 0.1; } equations { U 0.1; h 0.1; k 0.1; omega 0.1; } }
