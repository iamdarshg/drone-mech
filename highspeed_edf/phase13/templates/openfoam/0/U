FoamFile
{
    version 2.0;
    format ascii;
    class volVectorField;
    object U;
}
dimensions [0 1 -1 0 0 0 0];
internalField uniform (@U_IN_X@ 0 0);
boundaryField
{
    inlet { type fixedValue; value uniform (@U_IN_X@ 0 0); }
    outlet { type pressureInletOutletVelocity; value uniform (0 0 @U_OUT_INITIAL@); }
    walls { type noSlip; }
}
