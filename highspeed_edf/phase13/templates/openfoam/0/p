FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object p;
}
dimensions [1 -1 -2 0 0 0 0];
internalField uniform @P_INITIAL@;
boundaryField
{
    inlet { type fixedValue; value uniform @P_IN@; }
    outlet { type fixedValue; value uniform @P_OUT_STATIC@; }
    walls { type zeroGradient; }
}
