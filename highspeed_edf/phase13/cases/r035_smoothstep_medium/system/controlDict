FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application rhoSimpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 250;
deltaT 1;
writeControl timeStep;
writeInterval 10;
purgeWrite 2;
writeFormat ascii;
writePrecision 10;
writeCompression off;
runTimeModifiable false;
functions
{
    inletAverage
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        regionType patch;
        name inlet;
        operation areaAverage;
        fields (p U T);
        writeControl timeStep;
        writeInterval 10;
    }
    outletAverage
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        regionType patch;
        name outlet;
        operation areaAverage;
        fields (p U T);
        writeControl timeStep;
        writeInterval 10;
    }
    inletMassFlow
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        regionType patch;
        name inlet;
        operation sum;
        fields (phi);
        writeControl timeStep;
        writeInterval 10;
    }
    outletMassFlow
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        regionType patch;
        name outlet;
        operation sum;
        fields (phi);
        writeControl timeStep;
        writeInterval 10;
    }
}
